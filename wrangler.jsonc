{
  // Pure static-assets Worker — no adapter, no KV/Images bindings.
  // Name must match the Cloudflare Workers Builds Worker exactly.
  "name": "business-document-generators",
  "compatibility_date": "2026-10-19",
  "assets": {
    // Astro static build output (`npm run build`)
    "directory": "./dist",
    // Serve nearest 404.html for missing routes (Astro emits dist/404.html)
    "not_found_handling": "404-page",
    // Match Astro `trailingSlash: 'always'` (folder index.html → trailing slash)
    "html_handling": "force-trailing-slash"
  }
}
