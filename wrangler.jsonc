/**
 * Static assets + run-first Worker for 308 trailing-slash redirects.
 * Workers Builds: npm run build → npx wrangler deploy && node scripts/indexnow.mjs
 *
 * Build-time PUBLIC_* belong in Cloudflare Workers Builds → Variables
 * (.env.example). Do NOT put PUBLIC_* in top-level wrangler "vars" — that
 * breaks `npx wrangler preview` unless mirrored under previews.vars, and
 * still does not bake Astro HTML.
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "business-document-generators",
  "compatibility_date": "2026-10-19",
  // Worker issues 308 trailing-slash redirects before assets
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    // Matches astro.config trailingSlash: 'always' (slash redirects handled in worker as 308)
    "html_handling": "force-trailing-slash"
  },
  // Required by `npx wrangler preview` (non-production Workers Builds command).
  "previews": {}
}
