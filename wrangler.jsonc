/**
 * Static assets + run-first Worker for legacy-host 301s and 308 trailing-slash
 * redirects. Workers Builds: npm run build → npx wrangler deploy && node scripts/indexnow.mjs
 *
 * Build-time PUBLIC_* belong in Cloudflare Workers Builds → Variables
 * (.env.example). Do NOT put PUBLIC_* in top-level wrangler "vars" — that
 * breaks `npx wrangler preview` unless mirrored under previews.vars, and
 * still does not bake Astro HTML.
 *
 * Worker runtime vars (not PUBLIC_*): CANONICAL_ORIGIN + LEGACY_REDIRECT_HOSTS
 * for host 301s. Override in the Cloudflare dashboard if the apex or legacy
 * hosts change; see docs/CONFIGURATION.md and docs/CUSTOM-DOMAIN.md.
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "business-document-generators",
  "compatibility_date": "2026-10-19",
  // Worker issues legacy 301 + 308 trailing-slash redirects before assets
  "main": "src/worker.ts",
  "vars": {
    "CANONICAL_ORIGIN": "https://docuklin.com",
    "LEGACY_REDIRECT_HOSTS": "business-document-generators.hammadiqbal117.workers.dev"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    // Matches astro.config trailingSlash: 'always' (slash redirects handled in worker as 308)
    "html_handling": "force-trailing-slash"
  },
  // Required by `npx wrangler preview` (non-production Workers Builds command).
  "previews": {
    "vars": {
      "CANONICAL_ORIGIN": "https://docuklin.com",
      "LEGACY_REDIRECT_HOSTS": "business-document-generators.hammadiqbal117.workers.dev"
    }
  }
}
