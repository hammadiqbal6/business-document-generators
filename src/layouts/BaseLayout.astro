---
import '../styles/global.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Head from '../components/seo/Head.astro';
import Analytics from '../components/seo/Analytics.astro';
import { siteConfig } from '../config/site';
import { organizationJsonLd, personJsonLd, webSiteJsonLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: object[];
  /** When false, caller supplies WebSite/Organization/Person (e.g. home @graph). */
  includeSiteGraph?: boolean;
  ogImagePath?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  path,
  ogType,
  noindex,
  jsonLd = [],
  includeSiteGraph = true,
  ogImagePath,
  ogImageAlt,
} = Astro.props;
const allLd = includeSiteGraph
  ? [webSiteJsonLd(), organizationJsonLd(), personJsonLd(), ...jsonLd]
  : jsonLd;
---
<!doctype html>
<html lang="en">
  <head>
    <Head
      title={title}
      description={description}
      path={path}
      ogType={ogType}
      noindex={noindex}
      jsonLd={allLd}
      ogImagePath={ogImagePath}
      ogImageAlt={ogImageAlt}
    />
    <Analytics />
    {siteConfig.adsEnabled && siteConfig.adsensePublisherId && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.adsensePublisherId}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class="site-main">
      <slot />
    </main>
    <SiteFooter />

    <div
      id="cookie-banner"
      class="cookie-banner"
      role="dialog"
      aria-modal="false"
      aria-label="Cookie notice"
      hidden
    >
      <p>
        We use cookies for analytics.
        <a href="/cookies/">Privacy</a>
      </p>
      <div class="cookie-banner__actions">
        <button type="button" class="btn btn--primary" data-cookie-accept>OK</button>
      </div>
    </div>

    <script>
      const KEY = 'docuforge:cookie-ok';
      const banner = document.getElementById('cookie-banner');
      if (banner) {
        try {
          if (!localStorage.getItem(KEY)) {
            banner.hidden = false;
            document.body.classList.add('has-cookie-banner');
          }
        } catch {
          banner.hidden = false;
          document.body.classList.add('has-cookie-banner');
        }
        banner.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
          try {
            localStorage.setItem(KEY, '1');
          } catch {
            /* ignore */
          }
          banner.hidden = true;
          document.body.classList.remove('has-cookie-banner');
          const grant = (window as Window & { __docuforgeGrantAnalytics?: () => void })
            .__docuforgeGrantAnalytics;
          grant?.();
        });
      }
    </script>
  </body>
</html>
