---
import '../styles/global.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Head from '../components/seo/Head.astro';
import Analytics from '../components/seo/Analytics.astro';
import { siteConfig } from '../config/site';
import { organizationJsonLd, personJsonLd, webSiteJsonLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: object[];
  /** When false, caller supplies WebSite/Organization/Person (e.g. home @graph). */
  includeSiteGraph?: boolean;
  ogImagePath?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  path,
  ogType,
  noindex,
  jsonLd = [],
  includeSiteGraph = true,
  ogImagePath,
  ogImageAlt,
} = Astro.props;
const allLd = includeSiteGraph
  ? [webSiteJsonLd(), organizationJsonLd(), personJsonLd(), ...jsonLd]
  : jsonLd;
---
<!doctype html>
<html lang={siteConfig.htmlLang}>
  <head>
    <Head
      title={title}
      description={description}
      path={path}
      ogType={ogType}
      noindex={noindex}
      jsonLd={allLd}
      ogImagePath={ogImagePath}
      ogImageAlt={ogImageAlt}
    />
    <style is:inline set:html={`:root{--brand:${siteConfig.themeColor};--brand-bright:${siteConfig.themeColor};--focus-ring:${siteConfig.themeColor}}`} />
    <Analytics />
    {siteConfig.adsEnabled && siteConfig.adsensePublisherId && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.adsensePublisherId}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class="site-main">
      <slot />
    </main>
    <SiteFooter />

    <div
      id="cookie-banner"
      class="cookie-banner"
      role="dialog"
      aria-modal="false"
      aria-label="Cookie notice"
      hidden
    >
      <p>
        We use cookies for analytics.
        <a href="/cookies/">Privacy</a>
      </p>
      <div class="cookie-banner__actions">
        <button type="button" class="btn btn--ghost" data-cookie-reject>Reject</button>
        <button type="button" class="btn btn--primary" data-cookie-accept>Accept</button>
      </div>
    </div>

    <script is:inline define:vars={{ adsEnabled: siteConfig.adsEnabled && !!siteConfig.adsensePublisherId }}>
      (function () {
        var KEY = 'docuforge:cookie-ok';
        var banner = document.getElementById('cookie-banner');
        if (!banner) return;

        function dismissBanner() {
          banner.hidden = true;
          document.body.classList.remove('has-cookie-banner');
        }

        function showBanner() {
          banner.hidden = false;
          document.body.classList.add('has-cookie-banner');
        }

        function geoSaysConsentRegion() {
          var geo = window.__docuklinGeo;
          return !!(geo && geo.consentRegion);
        }

        function tcfGdprApplies(cb) {
          var api = window.__tcfapi;
          if (typeof api !== 'function') {
            cb(false);
            return;
          }
          try {
            api('getTCData', 2, function (tcData, success) {
              cb(!!(success && tcData && tcData.gdprApplies === true));
            });
          } catch (e) {
            cb(false);
          }
        }

        // Google CMP only when ads can load + visitor is in EEA/UK/CH (geo and/or TCF).
        function shouldDeferToGoogleCmp(cb) {
          if (!adsEnabled) {
            cb(false);
            return;
          }
          if (geoSaysConsentRegion()) {
            cb(true);
            return;
          }
          var settled = false;
          function finish(defer) {
            if (settled) return;
            settled = true;
            cb(defer);
          }
          tcfGdprApplies(function (applies) {
            if (applies) finish(true);
          });
          window.setTimeout(function () {
            tcfGdprApplies(finish);
          }, 800);
        }

        shouldDeferToGoogleCmp(function (defer) {
          if (defer) {
            dismissBanner();
            return;
          }
          try {
            if (!localStorage.getItem(KEY)) showBanner();
          } catch (e) {
            showBanner();
          }
        });

        var accept = banner.querySelector('[data-cookie-accept]');
        var reject = banner.querySelector('[data-cookie-reject]');
        if (accept) {
          accept.addEventListener('click', function () {
            try {
              localStorage.setItem(KEY, '1');
            } catch (e) {
              /* ignore */
            }
            dismissBanner();
            if (typeof window.__docuforgeGrantAnalytics === 'function') {
              window.__docuforgeGrantAnalytics();
            }
          });
        }
        if (reject) {
          reject.addEventListener('click', function () {
            try {
              localStorage.setItem(KEY, '0');
            } catch (e) {
              /* ignore */
            }
            dismissBanner();
            if (typeof window.__docuforgeDenyAnalytics === 'function') {
              window.__docuforgeDenyAnalytics();
            }
          });
        }
      })();
    </script>
  </body>
</html>
