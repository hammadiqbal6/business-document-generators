---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/content/Breadcrumbs.astro';
import { allTools, CATEGORY_META } from '../../data/tools';
import type { ToolCategory } from '../../data/tools/types';
import { breadcrumbJsonLd, collectionPageJsonLd } from '../../lib/seo';

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Tools', path: '/tools/' }];
const byCat = Object.keys(CATEGORY_META) as ToolCategory[];
const path = '/tools/';
const jsonLd = [
  breadcrumbJsonLd(crumbs),
  collectionPageJsonLd({
    name: 'All document generators',
    description:
      'Browse free niche document generators: estimates, invoices, contracts, forms, and creative templates. Export PDF or DOCX in your browser.',
    path,
    items: allTools.map((t) => ({ name: t.name, path: `/tools/${t.slug}/` })),
  }),
];
---
<BaseLayout
  title="Free Business Document Generators"
  description="Browse 16+ free niche document generators: estimates, invoices, contracts, forms, and creative templates. Export PDF or DOCX in your browser."
  path={path}
  jsonLd={jsonLd}
  ogImagePath="/og/home.svg"
  ogImageAlt="DocuForge Tools — all free document generators"
>
  <Breadcrumbs items={crumbs} />
  <h1>All document generators</h1>
  <p class="lead answer-first">
    Pick a template, fill the form, preview live, and export PDF or DOCX. Nothing is stored on our servers—optional drafts save in your browser only.
  </p>
  <div class="summary-box">
    <p>
      How it works: open a generator → fill fields → live preview → download PDF or DOCX. No signup, no watermark, and your document text never leaves your device.
    </p>
  </div>

  {byCat.map((cat) => {
    const meta = CATEGORY_META[cat];
    const tools = allTools.filter((t) => t.category === cat);
    return (
      <section>
        <h2><a href={`/hubs/${meta.slug}/`}>{meta.name}</a></h2>
        <p>{meta.description}</p>
        <div class="tool-grid">
          {tools.map((t) => (
            <a class="tool-card" href={`/tools/${t.slug}/`}>
              <h3>{t.shortName}</h3>
              <p>{t.answerFirst.slice(0, 110)}…</p>
            </a>
          ))}
        </div>
      </section>
    );
  })}

  <h2>Privacy and security</h2>
  <p>
    We never receive your contract text, line items, or client names. Optional “Save locally” uses localStorage on your device. For legal-adjacent pages, edit clauses and have qualified counsel review before signing.
  </p>
</BaseLayout>
