---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/content/Breadcrumbs.astro';
import RelatedTools from '../../components/content/RelatedTools.astro';
import LearnMoreGuides from '../../components/content/LearnMoreGuides.astro';
import SisterTools from '../../components/content/SisterTools.astro';
import ToolPageContent from '../../components/content/ToolPageContent.astro';
import EmbedSnippet from '../../components/content/EmbedSnippet.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import DocumentGeneratorLazy from '../../components/generators/DocumentGeneratorLazy.astro';
import SampleDocumentPreview from '../../components/generators/SampleDocumentPreview.astro';
import { allTools, getRelatedTools, CATEGORY_META } from '../../data/tools';
import { siteConfig } from '../../config/site';
import {
  absoluteUrl,
  breadcrumbJsonLd,
  faqPageJsonLd,
  toolPageGraphJsonLd,
} from '../../lib/seo';

export function getStaticPaths() {
  return allTools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props;
const category = CATEGORY_META[tool.category];
const pagePath = `/tools/${tool.slug}/`;
const pageUrl = absoluteUrl(pagePath);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Tools', path: '/tools/' },
  { name: category.name, path: `/hubs/${category.slug}/` },
  { name: tool.shortName, path: pagePath },
];
const faqLd = faqPageJsonLd(tool.content.faq);
const jsonLd = [
  breadcrumbJsonLd(crumbs),
  toolPageGraphJsonLd(tool, pageUrl),
  ...(faqLd ? [faqLd] : []),
];
const related = getRelatedTools(tool);
const previewImage = `/images/tools/${tool.slug}.svg`;
const ogImagePath = `/og/tool-${tool.slug}.svg`;

/** Short answer-first lead (≤45 words) so the first form input stays above the mobile fold. */
function shortLead(text: string, maxWords = 40): string {
  const words = text.trim().split(/\s+/);
  if (words.length <= maxWords) return text.trim();
  return `${words.slice(0, maxWords).join(' ').replace(/[.,;:]+$/, '')}.`;
}
const lead = shortLead(tool.answerFirst, 40);
---
<BaseLayout
  title={tool.title}
  description={tool.metaDescription}
  path={pagePath}
  ogType="website"
  jsonLd={jsonLd}
  ogImagePath={ogImagePath}
  ogImageAlt={`${tool.shortName} template — DocuForge Tools`}
>
  <Breadcrumbs items={crumbs} />
  <header class="tool-header">
    <h1>{tool.h1}</h1>
    <p class="lead answer-first">{lead}</p>
  </header>

  <DocumentGeneratorLazy tool={tool} autoOpen={true} />

  <nav class="tool-jump" aria-label="On this page">
    <a href="#tool-editor">Editor</a>
    <a href="#tool-guide">Guide &amp; FAQ</a>
    <a href="#embed-h">Embed</a>
  </nav>

  <p class="content-meta byline tool-byline">
    Built and maintained by
    <a href="/about/#maintainer" rel="author">{siteConfig.author.name}</a>
    · Last reviewed <time datetime={tool.updatedAt}>{tool.updatedAt}</time>
    · <a href="/methodology/">How this tool works</a>
  </p>

  <AdSlot slot="tool-mid" minHeight={250} />

  <div id="tool-guide">
    <ToolPageContent tool={tool} />
  </div>

  <details class="sample-details">
    <summary>Sample filled preview (static)</summary>
    <SampleDocumentPreview tool={tool} />
  </details>

  <figure class="tool-figure tool-figure--below">
    <img
      src={previewImage}
      width="720"
      height="400"
      alt={`Document preview illustration for the ${tool.shortName} template showing typical fields and layout`}
      loading="lazy"
      decoding="async"
    />
    <figcaption>
      Illustration of a filled {tool.shortName.toLowerCase()} — customize yours in the editor above.
    </figcaption>
  </figure>

  <LearnMoreGuides toolSlug={tool.slug} />

  <SisterTools toolSlug={tool.slug} />

  <RelatedTools tools={related} />

  <EmbedSnippet tool={tool} />
</BaseLayout>

<style>
  .tool-header {
    margin-bottom: 0.75rem;
  }
  .tool-header .lead {
    margin-bottom: 0.5rem;
    max-width: 62ch;
  }
  .tool-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    margin: 0.35rem 0 0.75rem;
    font-size: 0.92rem;
  }
  .tool-jump a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .tool-byline {
    margin: 1rem 0 1.25rem;
  }
  .sample-details {
    margin: 1.5rem 0;
    border: 1px solid var(--border, #d8e3de);
    border-radius: 8px;
    padding: 0.5rem 0.85rem 0.85rem;
    background: var(--surface, #f8faf9);
  }
  .sample-details summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.35rem 0;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .tool-figure--below {
    margin-top: 1.5rem;
  }
</style>
