---
import '../../../styles/global.css';
import DocumentGeneratorLazy from '../../../components/generators/DocumentGeneratorLazy.astro';
import { allTools } from '../../../data/tools';
import { siteConfig } from '../../../config/site';
import { absoluteUrl } from '../../../lib/seo';

export function getStaticPaths() {
  return allTools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props;
const canonical = absoluteUrl(`/tools/${tool.slug}/`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>{tool.name} (embed) | {siteConfig.siteName}</title>
    <meta name="description" content={tool.metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content={siteConfig.themeColor} />
    {siteConfig.googleSiteVerification && (
      <meta name="google-site-verification" content={siteConfig.googleSiteVerification} />
    )}
    {/*
      No GA4/gtag on embeds. The previous ungated snippet loaded gtag.js without Consent Mode,
      and scanners harvested identifiers from that script (e.g. gtag.config, gtm.videoCurrentTime)
      as relative URLs under /tools/<slug>/embed/, producing 404 noise. Parent tool pages keep
      consent-gated Analytics.astro; trackEvent() no-ops here when window.gtag is absent.
    */}
  </head>
  <body style="margin:0;padding:0.5rem;font-family:system-ui,sans-serif;">
    <h1 class="sr-only">{tool.h1}</h1>
    <p class="embed-credit" style="font-size:0.85rem;margin:0 0 0.5rem;">
      <a href={`/tools/${tool.slug}/`} target="_top" rel="noopener">{tool.name}</a>
      —
      {/* Visible dofollow credit → canonical tool page (backlink support). */}
      <a href={canonical} target="_top">Made with {siteConfig.siteName}</a>
    </p>
    <DocumentGeneratorLazy tool={tool} embed={true} />
  </body>
</html>
