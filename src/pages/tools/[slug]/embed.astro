---
import '../../../styles/global.css';
import DocumentGeneratorLazy from '../../../components/generators/DocumentGeneratorLazy.astro';
import { allTools } from '../../../data/tools';
import { siteConfig } from '../../../config/site';

export function getStaticPaths() {
  return allTools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>{tool.name} (embed) | {siteConfig.siteName}</title>
    <link rel="canonical" href={`/tools/${tool.slug}/`} />
    {siteConfig.googleSiteVerification && (
      <meta name="google-site-verification" content={siteConfig.googleSiteVerification} />
    )}
    {siteConfig.ga4MeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.ga4MeasurementId}`}></script>
        <script is:inline define:vars={{ id: siteConfig.ga4MeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </>
    )}
  </head>
  <body style="margin:0;padding:0.5rem;font-family:system-ui,sans-serif;">
    <p style="font-size:0.85rem;margin:0 0 0.5rem;">
      <a href={`/tools/${tool.slug}/`} target="_top" rel="noopener">{tool.name}</a>
      — powered by {siteConfig.siteName}
    </p>
    <DocumentGeneratorLazy tool={tool} embed={true} />
  </body>
</html>
