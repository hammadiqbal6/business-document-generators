---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/content/Breadcrumbs.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import { siteConfig } from '../config/site';

const path = '/contact/';
const { serviceId, templateId, publicKey } = siteConfig.emailjs;
const emailjsReady = Boolean(serviceId && templateId && publicKey);
---
<BaseLayout
  title={`Contact ${siteConfig.siteName} – Email and Corrections`}
  description={`Contact ${siteConfig.siteName} by email for corrections, privacy requests, or feedback on our free document generators and educational business guides.`}
  path={path}
>
  <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Contact', path }]} />
  <h1>Contact</h1>
  <p class="lead">
    This site is maintained by <a href="/about/#maintainer">{siteConfig.author.name}</a>.
    For corrections, broken links, or product feedback, use the form below or email directly—there is no support ticket queue.
  </p>
  <p>
    Good messages to send: factual corrections on a guide or tool page (include the URL), broken internal links, accessibility
    issues, or privacy requests about cookies and analytics. We read mail personally; response time varies.
  </p>
  <p>
    Please do not send confidential client contracts, medical details, or full rental applications for “review.” These tools are
    educational generators—not a law firm, clinic, or landlord screening service—and we cannot give legal, medical, or housing advice.
  </p>

  {emailjsReady ? (
    <>
      <h2 class="contact-form-heading">Send a message</h2>
      <ContactForm serviceId={serviceId} templateId={templateId} publicKey={publicKey} />
      <noscript>
        <p>
          JavaScript is required for the form.
          Email <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a> instead.
        </p>
      </noscript>
      <p>
        Or email directly:
        <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
      </p>
    </>
  ) : (
    <p>
      Email: <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
    </p>
  )}

  <p>
    For privacy requests (cookies, analytics), include “Privacy” in the subject line and the page URL you visited.
    We do not host user-generated documents on our servers, so we typically have no form contents to delete—see the
    <a href="/privacy/">privacy policy</a> and <a href="/cookies/">cookie notice</a>.
  </p>
</BaseLayout>

<style>
  .contact-form-heading {
    font-size: 1.15rem;
    margin: 1.25rem 0 0.5rem;
  }
</style>
