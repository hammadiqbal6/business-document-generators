---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/content/Breadcrumbs.astro';
import { siteConfig } from '../../config/site';
import { CATEGORY_META, getToolsByCategory } from '../../data/tools';
import type { ToolCategory } from '../../data/tools/types';
import { guides } from '../../data/guides';
import { hubToGuides } from '../../data/toolGuideMap';
import { breadcrumbJsonLd, collectionPageJsonLd, faqPageJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return (Object.keys(CATEGORY_META) as ToolCategory[]).map((category) => ({
    params: { category: CATEGORY_META[category].slug },
    props: { category },
  }));
}

const hubCopy: Record<
  ToolCategory,
  {
    title: string;
    description: string;
    intro: string;
    whenToUse: string;
    whatFor: string[];
    whatToInclude: string[];
    commonMistakes: string[];
    workedExample: string;
    whichTable: { headers: string[]; rows: { need: string; toolLabel: string; toolSlug: string; why: string }[] };
    faq: { question: string; answer: string }[];
  }
> = {
  'estimates-invoices': {
    title: 'Free Estimate & Invoice Templates (PDF)',
    description:
      'Free contractor estimate, quote, invoice, receipt and work order templates—construction, roofing, painting, landscaping, flooring and more. PDF/Word, no signup.',
    intro:
      'Start with the free quote & estimate generator when you need a priced PDF today, then move to invoices, receipts, and work orders as the job progresses. Also here: construction quotes/estimates, roofing, painting, landscaping, and flooring presets, change orders, purchase orders, timesheets, progress invoices, cleaning and catering quotes—all with live preview and PDF/DOCX export for contractors and freelancers.',
    whenToUse:
      'Lead with the free quote & estimate generator for mixed service scopes. Use the construction estimate template as your construction quote generator for remodel bids with allowances; roofing, painting, landscaping, or flooring presets for trade-specific line items; the change-order template when scope shifts after approval; the purchase-order template when buying materials; the timesheet when tracking hours; the free invoice generator for contractors for deposits and line-item billing; the progress invoice generator for contract draws with retainage; cleaning or catering tools when line items are service packages; and the receipt or work order when you need a simple confirmation or job ticket.',
    whatFor: [
      'An estimate or quote proposes price and scope before work starts so the client can approve (or revise) before you mobilize—critical for contractors comparing labor and materials across bids.',
      'An invoice requests payment for a deposit, progress draw, or completed work and should match what was previously agreed on the estimate or quote.',
      'A receipt confirms money already received; a work order tells the crew what to do on site without doubling as a tax invoice.',
      'Trade presets (roofing, painting, landscaping, flooring) reuse the same commercial math with product-specific defaults so freelancers and specialty crews are not starting from a blank kitchen remodel sample.',
    ],
    whatToInclude: [
      'Parties and contact details, dates, and a clear document number or revision label.',
      'Line items with units, quantities, and rates—plus tax, deposits, and balance due when you are billing.',
      'Validity or payment terms, exclusions or allowances, and how change orders will be handled.',
      'For construction quotes: measurable scope, labor vs materials where helpful, and written assumptions about access and owner-supplied items.',
    ],
    commonMistakes: [
      'Sending an invoice before the client accepted an estimate (or sending an estimate that looks like a demand for payment).',
      'Omitting tax, deposit math, or a due date so the client cannot tell what is still owed.',
      'Vague line items (“misc labor”) that invite disputes—name rooms, packages, or phases instead.',
      'Using one generic remodel sample for a specialty trade when a roofing, flooring, or landscaping preset would show the right units.',
    ],
    workedExample:
      'A remodeler sends a construction estimate (also labeled as a construction quote) with allowances for tile, then a contractor invoice for a 30% deposit after acceptance, and later a receipt when the deposit clears. A landscaper or flooring crew can start from the matching trade preset so plant counts or waste square footage already sit on the PDF. Each document reuses the same party names and job address so the paper trail stays consistent.',
    whichTable: {
      headers: ['Need', 'Use this tool', 'Why'],
      rows: [
        { need: 'Free instant quote / estimate', toolLabel: 'Free quote & estimate generator', toolSlug: 'quote-estimate-generator', why: 'Mixed scopes with validity date' },
        { need: 'Construction quote / remodel bid', toolLabel: 'Free construction estimate template', toolSlug: 'construction-estimate-template', why: 'Scope + labor/materials + deposit' },
        { need: 'Roof replacement / repair bid', toolLabel: 'Roofing estimate template', toolSlug: 'roofing-estimate', why: 'Tear-off, squares, flashing, disposal' },
        { need: 'Interior or exterior paint bid', toolLabel: 'Painting estimate template', toolSlug: 'painting-estimate', why: 'Prep, primer, coats, rooms/sq ft' },
        { need: 'Yard / hardscape bid', toolLabel: 'Landscaping estimate template', toolSlug: 'landscaping-estimate', why: 'Demo, plants, mulch, pavers' },
        { need: 'Flooring install bid', toolLabel: 'Flooring estimate template', toolSlug: 'flooring-estimate', why: 'Tear-out, underlayment, sq ft + waste' },
        { need: 'Scope change after approval', toolLabel: 'Change order template', toolSlug: 'change-order-template', why: 'Delta price, revised timeline' },
        { need: 'Buy materials / supplies', toolLabel: 'Purchase order template', toolSlug: 'purchase-order-template', why: 'Vendor PO with quantities' },
        { need: 'Track labor hours', toolLabel: 'Timesheet template', toolSlug: 'timesheet-template', why: 'Daily/weekly hours PDF' },
        { need: 'Bill for work or deposit', toolLabel: 'Free invoice generator for contractors', toolSlug: 'contractor-invoice', why: 'Totals, tax, balance due' },
        { need: 'Progress draw / retainage', toolLabel: 'Progress invoice generator', toolSlug: 'progress-invoice', why: 'Contract value, % complete, retainage' },
        { need: 'Overdue invoice late fee', toolLabel: 'Invoice late fee calculator', toolSlug: 'invoice-late-fee-calculator', why: 'Days late, fee, reminder wording' },
        { need: 'House cleaning invoice', toolLabel: 'Cleaning service invoice', toolSlug: 'cleaning-service-invoice', why: 'Room/package line items' },
        { need: 'Event food package', toolLabel: 'Catering quote', toolSlug: 'catering-quote', why: 'Per-guest math and deposit notes' },
        { need: 'Proof of payment', toolLabel: 'Free receipt generator', toolSlug: 'receipt-generator', why: 'Amount paid, method, balance' },
        { need: 'Assign the job to crew', toolLabel: 'Work order', toolSlug: 'work-order', why: 'Tasks, parts, sign-off' },
      ],
    },
    faq: [
      {
        question: 'Which should I send: estimate, quote or invoice?',
        answer:
          'Send a free quote or estimate before work starts so the client can approve scope and price. Switch to an invoice only when you are billing a deposit, progress draw, or completed work.',
      },
      {
        question: 'What is the difference between an estimate and an invoice?',
        answer:
          'An estimate (or quote) proposes price and scope; an invoice requests payment. Many trades use quote and estimate interchangeably—state validity either way, and keep invoice line items aligned with what was accepted.',
      },
      {
        question: 'What goes on each document?',
        answer:
          'Estimates and quotes need parties, dated scope, line items, tax/deposit notes, and a validity window. Invoices add invoice number, due date, amount due, and payment instructions. Receipts confirm amount paid and method; work orders list tasks for the crew.',
      },
      {
        question: 'Where do I start for a free estimate generator?',
        answer:
          'Use /tools/quote-estimate-generator/ for mixed service scopes (the free estimate / quote estimate generator). For remodel bids or a construction quote with allowances, use /tools/construction-estimate-template/ instead. Specialty crews can open roofing, painting, landscaping, or flooring presets.',
      },
      {
        question: 'Do these tools store my client data?',
        answer:
          'No. Preview and export run in your browser. Optional drafts use localStorage on your device only.',
      },
    ],
  },
  contracts: {
    title: 'Free Contract Templates: Video, Service, Photo, NDA',
    description:
      'Free editable contract templates: videography, wedding video, video production, photography, service agreement, freelance, NDA and more. PDF/Word, no signup.',
    intro:
      'Start with a videography, wedding videography, or video production contract when usage rights matter, or a photography contract for stills. Also here: service agreements for freelancers and B2B retainers, freelance web design, event/wedding vendor, independent contractor, simple NDA, and lien waiver samples you can edit—then export PDF or DOCX. Not attorney-reviewed.',
    whenToUse:
      'Use the general videography contract for mixed video jobs; the wedding videography contract template for ceremony-to-reception coverage; the video production contract for brand films and milestone billing; photography contracts when still usage rights matter; the freelance web design contract for project milestones and IP; the event/wedding vendor contract for venue dates and force majeure style notes; the independent contractor agreement or service agreement for broader B2B scopes; the simple NDA when you only need a mutual confidentiality starting point; and the lien waiver generator for conditional/unconditional progress or final releases on construction pay apps.',
    whatFor: [
      'Service contracts set deliverables, payment schedule, cancellation, and who owns the work product after delivery.',
      'Creative contracts also need usage or licensing language so clients know how they may publish photos or video.',
      'An NDA is only about confidentiality—it does not replace a statement of work or payment terms.',
    ],
    whatToInclude: [
      'Legal names of the parties, effective date, and a short project description.',
      'Fees, deposits, late fees (if any), and what happens if the client cancels.',
      'Deliverables, revision limits, and intellectual-property or usage rights in plain language you can edit.',
    ],
    commonMistakes: [
      'Leaving usage rights blank on photo or video jobs so both sides assume opposite defaults.',
      'Using a generic NDA when you actually need a services agreement with payment milestones.',
      'Treating an exported sample as attorney-reviewed—local law and facts still matter.',
    ],
    workedExample:
      'A photographer fills coverage hours, retainer, and web-vs-print usage in the photography contract, exports PDF, and sends it with the invoice for the retainer. Separately, a freelancer sharing pitch decks may start with the simple NDA before sending a full web-design contract.',
    whichTable: {
      headers: ['Situation', 'Use this tool', 'Focus'],
      rows: [
        { need: 'Photo shoot or wedding day', toolLabel: 'Photography contract', toolSlug: 'photography-contract-template', why: 'Coverage hours, usage, retainer' },
        { need: 'General video project', toolLabel: 'Videography contract', toolSlug: 'videography-contract', why: 'Revisions, music, raw footage' },
        { need: 'Wedding day film', toolLabel: 'Wedding videography contract', toolSlug: 'wedding-videography-contract-template', why: 'Timeline, highlight, rain plan' },
        { need: 'Brand / commercial video', toolLabel: 'Video production contract', toolSlug: 'video-production-contract', why: 'Milestones, channel license' },
        { need: 'Website build', toolLabel: 'Web design contract', toolSlug: 'freelance-web-design-contract', why: 'Milestones, IP, content deadlines' },
        { need: 'Wedding / event vendor', toolLabel: 'Event vendor contract', toolSlug: 'event-wedding-vendor-contract', why: 'Date, overtime, force majeure' },
        { need: 'Hire a 1099 contractor', toolLabel: 'Independent contractor agreement', toolSlug: 'independent-contractor-agreement', why: 'Scope, payment, IP starting point' },
        { need: 'Ongoing services retainer', toolLabel: 'Service agreement template', toolSlug: 'service-agreement-template', why: 'Term, fees, termination' },
        { need: 'Share confidential info', toolLabel: 'Simple NDA', toolSlug: 'simple-nda', why: 'Mutual vs one-way starting point' },
        { need: 'Release lien rights with a pay app', toolLabel: 'Lien waiver generator', toolSlug: 'lien-waiver-generator', why: 'Conditional/unconditional × partial/final' },
      ],
    },
    faq: [
      {
        question: 'Which contract do I need?',
        answer:
          'Match the job: photography for stills; wedding videography for ceremony-to-reception films; video production for brand/commercial work; general videography when the job spans both; service agreement or independent contractor for broader B2B scopes; freelance web design for site builds; event/wedding vendor for date-bound gigs; NDA for confidentiality only; lien waiver for construction pay apps.',
      },
      {
        question: 'What is the difference between a contract and an agreement?',
        answer:
          'In everyday business use the words often mean the same thing—a written deal with parties, scope, and payment. Some industries prefer “service agreement” for ongoing retainers and “contract” for one-off creative or vendor jobs. Pick the template that matches your scope, not the label alone.',
      },
      {
        question: 'Do I need a lawyer for a template?',
        answer:
          'These pages are editable samples, not attorney-reviewed forms. Use a licensed lawyer for high-stakes, multi-state, or unusual deals; generators only speed a first draft.',
      },
      {
        question: 'Are these contracts legally binding?',
        answer:
          'A signed agreement can be binding, but enforceability depends on local law and the facts. Have counsel review before you rely on an exported sample.',
      },
      {
        question: 'Can I e-sign the PDF?',
        answer:
          'Export PDF or DOCX, then use your preferred e-sign tool. This site does not provide built-in e-signature.',
      },
      {
        question: 'Is the NDA mutual or one-way?',
        answer:
          'The simple NDA generator is a starting point you can edit. Confirm mutual vs one-way language with counsel for your deal.',
      },
    ],
  },
  forms: {
    title: 'Free Client Forms: Tattoo Consent & Rental Application',
    description:
      'Free fillable client forms for studios and landlords: tattoo consent and rental application with PDF/Word export in your browser—no signup.',
    intro:
      'Capture client acknowledgements and rental screening details with fillable forms you preview live and export as PDF or DOCX—then follow your local health or fair-housing rules. These forms sit beside Docuklin’s contractor and freelancer paperwork (estimates, invoices, contracts) but keep operational records separate from pricing PDFs. Timesheets and purchase orders live under Estimates & Invoices, not this forms hub.',
    whenToUse:
      'The tattoo consent form is for studio risk acknowledgements and aftercare notes before a session. The rental application gathers employment, income, and household details for screening—pair it with official fair-housing guidance and your local landlord-tenant rules. If you also need to price a job or bill a client, jump to the estimates & invoices hub rather than stretching a consent form into an invoice.',
    whatFor: [
      'Consent forms document that a client received risk and aftercare information before a body-art procedure—rules vary by jurisdiction and are not medical advice.',
      'Rental applications collect screening details so a landlord can evaluate an applicant; they do not create a tenancy by themselves and must follow fair-housing rules.',
      'Both are operational records you should store in your own system after export—this site does not keep form submissions.',
      'Freelancers and small contractors often keep these alongside contracts and invoices; use the matching hubs when you need pricing or agreement language instead.',
    ],
    whatToInclude: [
      'Studio or property identity, client/applicant name, date, and contact details.',
      'For tattoo consent: procedure description, risk acknowledgements, aftercare notes, and signature lines your local rules require.',
      'For rental applications: household members, employment/income fields, authorization to screen, and any locally required disclosures.',
      'A retention note in your own process—export PDF/DOCX and file it where you keep other client records.',
    ],
    commonMistakes: [
      'Using one generic consent form without checking state or county body-art requirements.',
      'Treating a completed rental application as a lease, or collecting screening data without a lawful purpose and fair-housing compliance.',
      'Leaving filled PDFs only in browser drafts instead of exporting into your retention process.',
      'Asking for information your local rules forbid (for example certain protected-class questions on rental forms).',
    ],
    workedExample:
      'A studio prints a tattoo consent PDF with aftercare notes before a session, then keeps the signed copy with the appointment record. Separately, a small landlord exports a rental application, pairs it with their screening criteria checklist and HUD fair-housing notes, and stores the file with other applicant records—not on this website. When the same landlord later hires a contractor for a unit turn, they price the work from the estimates hub and keep those PDFs in a different folder.',
    whichTable: {
      headers: ['Need', 'Use this tool', 'Remember'],
      rows: [
        { need: 'Studio risk acknowledgement', toolLabel: 'Tattoo consent form', toolSlug: 'tattoo-consent-form-template', why: 'Rules vary by state; not medical advice' },
        { need: 'Screen a prospective tenant', toolLabel: 'Rental application', toolSlug: 'rental-lease-application', why: 'Fair housing + screening authorization' },
      ],
    },
    faq: [
      {
        question: 'Is a tattoo consent form legally required?',
        answer:
          'Many jurisdictions require informed consent and record retention for body art. Check your state or local health department—not this template alone.',
      },
      {
        question: 'Does a rental application create a lease?',
        answer:
          'No. An application requests consideration; a signed lease (or local equivalent) creates tenancy after approval.',
      },
      {
        question: 'Can I store filled forms on this site?',
        answer:
          'No. Export PDF/DOCX and keep records in your own compliant system. Optional local drafts stay in your browser only.',
      },
      {
        question: 'Where can I read fair-housing rules?',
        answer:
          'Start with HUD Fair Housing materials and our rental fair-housing guide, then confirm state and local requirements.',
      },
      {
        question: 'Do these forms replace contracts or invoices?',
        answer:
          'No. Consent and rental applications are operational records. For pricing and payment, use the estimates & invoices hub; for service terms, use the contracts hub.',
      },
    ],
  },
  'creative-templates': {
    title: 'Podcast Script & Real Estate Flyer Templates (Free)',
    description:
      'Free podcast episode script planner and real estate / property flyer maker for creators and agents. PDF/Word export in your browser, no signup.',
    intro:
      'Structure a podcast episode or a one-page property flyer without starting from a blank page—fill fields, preview the layout, then download PDF or DOCX. These creative tools sit alongside Docuklin’s contractor and freelancer document generators when you need show notes or listing handouts rather than estimates or contracts.',
    whenToUse:
      'Use the podcast script when you need cold open, segment timings, guest prompts, and CTA placeholders before record day. Use the real estate flyer (property flyer maker) when you want beds, baths, price, and highlight bullets laid out for a one-page open-house or email handout. For listing agreements or vendor contracts, switch to the contracts hub instead of stretching a flyer into a legal form.',
    whatFor: [
      'A podcast script (or run-of-show) keeps openings, segments, sponsor reads, and calls-to-action on time so recording stays focused.',
      'A real estate flyer is a marketing handout for open houses or email—distinct from an MLS sheet, purchase contract, or contractor estimate.',
      'Both tools help you draft layout and wording; final brokerage, MLS, endorsement disclosure, or show-notes rules still apply outside this site.',
      'Creators who also sell services can pair a finished script outline with Docuklin invoices or service agreements when a client sponsors an episode.',
    ],
    whatToInclude: [
      'Podcast: episode title, cold open, timed segments, guest prompts, sponsor-read slots, and a clear CTA or show-notes list.',
      'Flyer: headline, price, beds/baths/sq ft, feature bullets, agent contact, and any required brokerage disclosure text.',
      'Export PDF for sharing or DOCX when you need to keep editing in Word or your notes app.',
      'A short checklist of photos or audio assets you will add after export (this generator does not host media).',
    ],
    commonMistakes: [
      'Over-scripting interview episodes so the conversation never breathes—use a run-of-show instead of a full teleprompter script.',
      'Shipping a flyer without brokerage or MLS-required disclosures, or using photos without usage rights.',
      'Treating the flyer generator as a substitute for listing-agreement paperwork.',
      'Leaving sponsor or endorsement disclosures off the script when a paid read is involved.',
    ],
    workedExample:
      'A host fills cold open, three segment prompts, a mid-roll sponsor slot, and a newsletter CTA in the podcast script, then exports DOCX into their notes app and marks timestamps after recording. An agent fills beds, price, and highlights in the flyer tool, exports PDF for an open-house stack, and adds photos in their design tool afterward. If the agent also hires a photographer, they pull a photography contract from the contracts hub rather than inventing usage terms on the flyer.',
    whichTable: {
      headers: ['Goal', 'Use this tool', 'Output'],
      rows: [
        { need: 'Plan an episode', toolLabel: 'Podcast script', toolSlug: 'podcast-script-template', why: 'Cold open, segments, CTA outline' },
        { need: 'Market a listing / property flyer', toolLabel: 'Real estate flyer', toolSlug: 'real-estate-flyer-template', why: 'One-page PDF/DOCX handout' },
      ],
    },
    faq: [
      {
        question: 'Should every podcast be fully scripted?',
        answer:
          'No. Use full scripts for solo storytelling; use run-of-show outlines for interviews so conversation stays natural.',
      },
      {
        question: 'Is the flyer an MLS sheet?',
        answer:
          'No. It is a marketing flyer. Follow brokerage and MLS rules for required disclosures and photo usage.',
      },
      {
        question: 'Can I add my own photos?',
        answer:
          'Export and place photos in your design tool or PDF editor. Respect photographer copyright and brokerage branding rules.',
      },
      {
        question: 'Do these tools require an account?',
        answer:
          'No signup. Everything runs in your browser with optional local drafts only.',
      },
      {
        question: 'Where do contractor estimates and contracts live?',
        answer:
          'Pricing PDFs are under the estimates & invoices hub; agreements are under the contracts hub. This creative hub stays on scripts and flyers.',
      },
    ],
  },
};

const { category } = Astro.props;
const meta = CATEGORY_META[category];
const copy = hubCopy[category];
const tools = getToolsByCategory(category);
const path = `/hubs/${meta.slug}/`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Tools', path: '/tools/' },
  { name: meta.name, path },
];
const hubGuideSlugs = hubToGuides[meta.slug] ?? [];
const hubGuides = hubGuideSlugs
  .map((slug) => guides.find((g) => g.slug === slug))
  .filter(Boolean);
const faqLd = faqPageJsonLd(copy.faq);
const jsonLd = [
  breadcrumbJsonLd(crumbs),
  collectionPageJsonLd({
    name: meta.name,
    description: copy.description,
    path,
    items: tools.map((t) => ({ name: t.name, path: `/tools/${t.slug}/` })),
  }),
  ...(faqLd ? [faqLd] : []),
];
const ogImagePath = `/og/hub-${meta.slug}.png`;

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

/** Turn bare /tools/.../ and /guides/.../ /hubs/.../ paths in hub FAQ into links. */
function linkInternalPaths(para: string): string {
  return escapeHtml(para)
    .replace(/\/tools\/[a-z0-9-]+\//g, (p) => `<a href="${p}">${p}</a>`)
    .replace(/\/guides\/[a-z0-9-]+\//g, (p) => `<a href="${p}">${p}</a>`)
    .replace(/\/hubs\/[a-z0-9-]+\//g, (p) => `<a href="${p}">${p}</a>`);
}
---
<BaseLayout
  title={copy.title}
  description={copy.description}
  path={path}
  jsonLd={jsonLd}
  ogImagePath={ogImagePath}
  ogImageAlt={`${meta.name} templates on ${siteConfig.siteName}`}
>
  <Breadcrumbs items={crumbs} />
  <h1>{meta.name}</h1>
  <p class="lead answer-first">{copy.intro}</p>
  {category === 'estimates-invoices' && (
    <p>
      Need a priced PDF today? Open the{' '}
      <a href="/tools/quote-estimate-generator/">free estimate generator</a>
      {' '}(quote estimate generator)—no signup, no watermark—then move to invoices and receipts as the job progresses.
    </p>
  )}

  <h2>When to use which document</h2>
  <p>{copy.whenToUse}</p>

  <h2>Which document do I need?</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          {copy.whichTable.headers.map((h) => (
            <th scope="col">{h}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {copy.whichTable.rows.map((row) => (
          <tr>
            <td>{row.need}</td>
            <td>
              <a href={`/tools/${row.toolSlug}/`}>{row.toolLabel}</a>
            </td>
            <td>{row.why}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Templates in this category</h2>
  <div class="tool-grid">
    {tools.map((t) => (
      <a class="tool-card" href={`/tools/${t.slug}/`}>
        <h3>{t.name}</h3>
        <p>{t.answerFirst.slice(0, 120)}…</p>
      </a>
    ))}
  </div>

  <h2>What these documents are for</h2>
  <ul>
    {copy.whatFor.map((item) => (
      <li>{item}</li>
    ))}
  </ul>

  <h2>What to include</h2>
  <ul>
    {copy.whatToInclude.map((item) => (
      <li>{item}</li>
    ))}
  </ul>

  <h2>Common mistakes</h2>
  <ul>
    {copy.commonMistakes.map((item) => (
      <li>{item}</li>
    ))}
  </ul>

  <h2>Worked example</h2>
  <p>{copy.workedExample}</p>

  {hubGuides.length > 0 && (
    <section aria-labelledby="hub-guides-heading">
      <h2 id="hub-guides-heading">Guides for this category</h2>
      <ul>
        {hubGuides.map((g) => (
          <li>
            <a href={`/guides/${g!.slug}/`}>{g!.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <h2>FAQ</h2>
  <div class="faq">
    {copy.faq.map((f) => (
      <details>
        <summary>{f.question}</summary>
        <p set:html={linkInternalPaths(f.answer)} />
      </details>
    ))}
  </div>

  <p><a href="/guides/">All how-to guides →</a></p>
</BaseLayout>

<style>
  .table-wrap {
    overflow-x: auto;
    margin: 1rem 0 1.5rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  th,
  td {
    border: 1px solid var(--border, #d8e3de);
    padding: 0.5rem 0.65rem;
    text-align: left;
    vertical-align: top;
  }
  th {
    background: var(--surface, #f8faf9);
  }
</style>
