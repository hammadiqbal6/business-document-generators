---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import { siteConfig } from '../config/site';
import { allTools, CATEGORY_META } from '../data/tools';
import type { ToolCategory } from '../data/tools/types';
import { homeGraphJsonLd } from '../lib/seo';

const featured = allTools.slice(0, 6);
const cats = Object.keys(CATEGORY_META) as ToolCategory[];
---
<BaseLayout
  title="Free Invoice, Estimate & Contract Templates (PDF/DOCX)"
  description="Fill free estimate, invoice, contract and consent form templates in your browser, preview them live and download PDF or Word. No signup, nothing uploaded."
  path="/"
  includeSiteGraph={false}
  jsonLd={[homeGraphJsonLd()]}
  ogImagePath="/og/home.svg"
  ogImageAlt="DocuForge Tools — free invoice, estimate, and contract templates"
>
  <section class="hero">
    <p class="content-meta" style="margin-bottom:0.35rem;">{siteConfig.siteName}</p>
    <h1>Free invoice, estimate &amp; contract templates</h1>
    <p class="lead">
      Create construction estimates, contractor invoices, photography contracts, NDAs, cleaning
      invoices, catering quotes, consent forms, and more in your browser. Fill the fields, preview
      the live document, then download PDF or DOCX—no signup and no server-side storage of your form
      data. Pick a generator below or browse by category.
    </p>
    <div class="hero-actions">
      <a href="/tools/">Browse all tools</a>
      <a class="secondary" href="/guides/">Read guides</a>
    </div>
  </section>

  <AdSlot slot="home-top" minHeight={90} />

  <section>
    <h2>What you can create</h2>
    <p>
      DocuForge Tools focuses on profession-specific paperwork that freelancers and small contractors
      need every week: construction estimates, contractor invoices, cleaning and catering quotes,
      photography and videography contracts, simple NDAs, tattoo consent forms, rental applications,
      podcast scripts, and real estate flyers. Each page pairs a working generator with original
      guidance, a worked example, FAQs, and cited public sources.
    </p>
    <p>
      Choose a category below, or jump straight to a popular template. Every tool uses the same
      privacy model: validation, preview, and PDF/DOCX export run entirely client-side.
    </p>
  </section>

  <section>
    <h2>Popular generators</h2>
    <div class="tool-grid">
      {featured.map((t) => (
        <a class="tool-card" href={`/tools/${t.slug}/`}>
          <h3>{t.shortName}</h3>
          <p>{t.answerFirst.slice(0, 110)}…</p>
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2>Browse by category</h2>
    <div class="tool-grid">
      {cats.map((c) => {
        const m = CATEGORY_META[c];
        return (
          <a class="tool-card" href={`/hubs/${m.slug}/`}>
            <h3>{m.name}</h3>
            <p>{m.description}</p>
          </a>
        );
      })}
    </div>
  </section>

  <section class="summary-box">
    <h2>Privacy-first</h2>
    <p>
      Every generator runs client-side in your browser. We do not upload your contracts, estimates, or client data. Optional drafts use localStorage on your device only. Maintained by{' '}
      <a href="/about/#maintainer">{siteConfig.author.name}</a>.
    </p>
  </section>
</BaseLayout>
