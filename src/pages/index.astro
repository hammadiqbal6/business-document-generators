---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import { siteConfig } from '../config/site';
import { CATEGORY_META, getFeaturedTools, getToolsByCategory, allTools } from '../data/tools';
import type { ToolCategory } from '../data/tools/types';
import { homeGraphJsonLd } from '../lib/seo';

const featured = getFeaturedTools();
const cats = Object.keys(CATEGORY_META) as ToolCategory[];
const toolCount = allTools.length;
---
<BaseLayout
  title="Free Estimate, Invoice & Contract Generator, No Signup"
  description="Make a free estimate, quote, invoice or contract in your browser. PDF and Word download, no signup, nothing uploaded."
  path="/"
  includeSiteGraph={false}
  jsonLd={[homeGraphJsonLd()]}
  ogImagePath="/og/home.png"
  ogImageAlt={`${siteConfig.siteName} — free contractor and freelancer document templates`}
>
  <section class="hero">
    <p class="content-meta" style="margin-bottom:0.35rem;">{siteConfig.siteName}</p>
    <h1>Free contractor &amp; freelancer document templates</h1>
    <p class="lead answer-first">
      Create construction estimates, contractor invoices, photography contracts, NDAs, and more in your
      browser—then download PDF or DOCX. No signup and no server-side storage. Pick a generator below.
    </p>
    <div class="hero-actions">
      <a href="/tools/quote-estimate-generator/">Free estimate generator</a>
      <a class="secondary" href="/tools/contractor-invoice/">Contractor invoice</a>
    </div>
  </section>

  <section aria-labelledby="popular-h">
    <h2 id="popular-h">Popular generators</h2>
    <div class="tool-grid">
      {featured.map((t) => (
        <a class="tool-card" href={`/tools/${t.slug}/`}>
          <h3>{t.name}</h3>
          <p>{t.answerFirst.slice(0, 110)}…</p>
        </a>
      ))}
    </div>
  </section>

  <AdSlot placement="home-top" minHeight={90} />

  <section aria-labelledby="all-tools-h">
    <h2 id="all-tools-h">All templates by category</h2>
    <p>
      Every generator on {siteConfig.siteName} is listed below ({toolCount} tools). Featured cards above are a shortlist;
      open a hub for category guidance, or jump straight to a template.
    </p>
    {cats.map((c) => {
      const m = CATEGORY_META[c];
      const tools = getToolsByCategory(c);
      return (
        <div class="home-cat-block">
          <h3>
            <a href={`/hubs/${m.slug}/`}>{m.name}</a>
          </h3>
          <ul class="tool-link-list">
            {tools.map((t) => (
              <li>
                <a href={`/tools/${t.slug}/`}>{t.shortName}</a>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </section>

  <section>
    <h2>What you can create</h2>
    <p>
      {siteConfig.siteName} focuses on profession-specific paperwork that freelancers and small contractors
      need every week. Start with a
      <a href="/tools/quote-estimate-generator/">free quote and estimate generator</a>,
      bill with a
      <a href="/tools/contractor-invoice/">free invoice generator for contractors</a>,
      confirm payment with a
      <a href="/tools/receipt-generator/">free receipt generator</a>,
      or price a remodel with a
      <a href="/tools/construction-estimate-template/">construction estimate / construction quote template</a>.
      Trade presets cover
      <a href="/tools/roofing-estimate/">roofing</a>,
      <a href="/tools/painting-estimate/">painting</a>,
      <a href="/tools/landscaping-estimate/">landscaping</a>, and
      <a href="/tools/flooring-estimate/">flooring</a>
      estimates with product-specific line items.
    </p>
    <p>
      Creative and service freelancers can open a
      <a href="/tools/photography-contract-template/">photography contract</a>,
      <a href="/tools/videography-contract/">videography contract</a>,
      <a href="/tools/wedding-videography-contract-template/">wedding videography contract</a>,
      <a href="/tools/video-production-contract/">video production contract</a>,
      <a href="/tools/service-agreement-template/">service agreement</a>,
      or simple NDA. Also: cleaning and catering quotes, tattoo consent forms, rental applications,
      podcast scripts, and real estate flyers.
    </p>
    <p>
      Choose a category below, or open the
      <a href="/hubs/estimates-invoices/">estimates &amp; invoices hub</a>
      for quote-to-invoice workflows and the
      <a href="/hubs/contracts/">contracts hub</a>
      for video, photo, and service agreements. Every tool uses the same privacy model: validation, preview, and
      PDF/DOCX export run entirely client-side.
    </p>
  </section>

  <section>
    <h2>How a contractor or freelancer usually uses these tools</h2>
    <ol>
      <li>
        Price the job with an estimate or quote (flagship free estimate generator, construction quote/estimate, or a trade preset).
      </li>
      <li>
        Lock scope with a matching contract when the work needs usage rights, milestones, or cancellation terms.
      </li>
      <li>
        Bill deposits and progress with a contractor invoice or progress invoice; confirm payments with a receipt.
      </li>
      <li>
        Document scope changes on a change order before you buy extras or extend the schedule.
      </li>
    </ol>
    <p>
      Guides under <a href="/guides/">How-to guides</a> walk through line-item math, photography and videography clauses,
      and invoice vs estimate wording without inventing legal requirements.
    </p>
  </section>

  <section>
    <h2>Browse by category</h2>
    <div class="tool-grid">
      {cats.map((c) => {
        const m = CATEGORY_META[c];
        return (
          <a class="tool-card" href={`/hubs/${m.slug}/`}>
            <h3>{m.name}</h3>
            <p>{m.description}</p>
          </a>
        );
      })}
    </div>
  </section>

  <section class="summary-box">
    <h2>Privacy-first</h2>
    <p>
      Every generator runs client-side in your browser. We do not upload your contracts, estimates, or client data. Optional drafts use localStorage on your device only. Maintained by{' '}
      <a href="/about/#maintainer">{siteConfig.author.name}</a>.
    </p>
  </section>
</BaseLayout>
