---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/content/Breadcrumbs.astro';
import AuthorBox from '../../components/content/AuthorBox.astro';
import RelatedTools from '../../components/content/RelatedTools.astro';
import RelatedGuides from '../../components/content/RelatedGuides.astro';
import { guides, getGuide } from '../../data/guides';
import { getToolBySlug } from '../../data/tools';
import { relatedGuidesFor } from '../../data/toolGuideMap';
import { articleJsonLd, breadcrumbJsonLd, faqPageJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug }, props: { guide: g } }));
}

const { guide } = Astro.props;
const path = `/guides/${guide.slug}/`;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Guides', path: '/guides/' }, { name: guide.title, path }];
const related = guide.relatedToolSlugs.map((s) => getToolBySlug(s)).filter(Boolean);
const relatedGuideSlugs = [
  ...(guide.relatedGuideSlugs ?? []),
  ...relatedGuidesFor(guide.slug),
].filter((s, i, arr) => s !== guide.slug && arr.indexOf(s) === i);
const relatedGuideList = relatedGuideSlugs
  .map((s) => getGuide(s))
  .filter(Boolean)
  .slice(0, 4);
const faqLd = faqPageJsonLd(guide.faq);
const jsonLd = [
  breadcrumbJsonLd(crumbs),
  articleJsonLd({
    title: guide.title,
    description: guide.metaDescription,
    path,
    publishedAt: guide.publishedAt,
    updatedAt: guide.updatedAt,
  }),
  ...(faqLd ? [faqLd] : []),
];
const pageTitle =
  guide.title.length > 60 ? guide.title.slice(0, 57).trim() + '…' : guide.title;

/** Pull 3 short takeaway bullets from the first section body when possible. */
const takeaways = guide.sections
  .slice(0, 2)
  .flatMap((s) =>
    s.body
      .split(/(?<=\.)\s+/)
      .map((sentence) => sentence.trim())
      .filter((sentence) => sentence.length > 40 && sentence.length < 160),
  )
  .slice(0, 3);
---
<BaseLayout
  title={pageTitle}
  description={guide.metaDescription}
  path={path}
  ogType="article"
  jsonLd={jsonLd}
  ogImagePath={`/og/guide-${guide.slug}.svg`}
  ogImageAlt={guide.title}
>
  <Breadcrumbs items={crumbs} />
  <article class="prose">
    <h1>{guide.title}</h1>
    <div class="summary-box answer-box">
      <p class="answer-first">{guide.answerFirst}</p>
      {takeaways.length > 0 && (
        <>
          <p class="takeaways-label"><strong>Key takeaways</strong></p>
          <ul class="takeaways">
            {takeaways.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </>
      )}
      {guide.legalNote && (
        <p class="legal-note-inline" role="note"><strong>Note:</strong> {guide.legalNote}</p>
      )}
    </div>
    {related[0] && (
      <p class="guide-cta">
        <a href={`/tools/${related[0]!.slug}/`}>Try the matching generator →</a>
      </p>
    )}
    <p class="content-meta byline">
      Built and maintained by <a href="/about/#maintainer" rel="author">Hammad Iqbal</a>
      · Last reviewed <time datetime={guide.updatedAt}>{guide.updatedAt}</time>
      · Published <time datetime={guide.publishedAt}>{guide.publishedAt}</time>
    </p>
    {guide.sections.map((s) => (
      <>
        <h2>{s.heading}</h2>
        {s.body.split(/\n\n+/).map((para) => (
          <p>{para}</p>
        ))}
        {s.table && (
          <div class="table-wrap">
            {s.table.caption && <p class="table-caption">{s.table.caption}</p>}
            <table>
              <thead>
                <tr>
                  {s.table.headers.map((h) => (
                    <th scope="col">{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {s.table.rows.map((row) => (
                  <tr>
                    {row.map((cell) => (
                      <td set:html={cell} />
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </>
    ))}
    <h2>FAQ</h2>
    <div class="faq">
      {guide.faq.map((f) => (
        <details>
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
    <AuthorBox updatedAt={guide.updatedAt} />
  </article>
  <RelatedTools tools={related} title="Try these generators" />
  <RelatedGuides guides={relatedGuideList as typeof guides} />
</BaseLayout>

<style>
  .answer-box .answer-first {
    margin: 0 0 0.75rem;
  }
  .takeaways-label {
    margin: 0.5rem 0 0.25rem;
  }
  .takeaways {
    margin: 0 0 0.75rem;
    padding-left: 1.25rem;
  }
  .legal-note-inline {
    margin: 0.75rem 0 0;
    font-size: 0.95rem;
    color: var(--muted, #4a5c56);
  }
  .guide-cta {
    margin: 0.75rem 0 1rem;
  }
  .table-wrap {
    overflow-x: auto;
    margin: 1rem 0 1.5rem;
  }
  .table-caption {
    font-size: 0.95rem;
    color: var(--muted, #4a5c56);
    margin: 0 0 0.35rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  th,
  td {
    border: 1px solid var(--border, #d8e3de);
    padding: 0.5rem 0.65rem;
    text-align: left;
    vertical-align: top;
  }
  th {
    background: var(--surface, #f8faf9);
  }
</style>
