---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/content/Breadcrumbs.astro';
import { guides } from '../../data/guides';
import { breadcrumbJsonLd, collectionPageJsonLd } from '../../lib/seo';

const path = '/guides/';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Guides', path }];
const jsonLd = [
  breadcrumbJsonLd(crumbs),
  collectionPageJsonLd({
    name: 'Guides',
    description:
      'Original guides on construction estimates, contracts, invoices, consent forms, and more—linked to free generators.',
    path,
    items: guides.map((g) => ({ name: g.title, path: `/guides/${g.slug}/` })),
  }),
];
---
<BaseLayout
  title="Guides for Business Documents & Contracts"
  description="Original guides on construction estimates, photography contracts, catering quotes, tattoo consent, and rental applications—linked to our free generators."
  path={path}
  jsonLd={jsonLd}
  ogImagePath="/og/guides.svg"
  ogImageAlt="DocuForge Tools business document guides"
>
  <Breadcrumbs items={crumbs} />
  <h1>Guides</h1>
  <p class="lead">Answer-first articles that support our tools and AdSense quality guidelines. Not legal advice where noted.</p>
  <div class="tool-grid">
    {guides.map((g) => (
      <a class="tool-card" href={`/guides/${g.slug}/`}>
        <h3>{g.title}</h3>
        <p>{g.metaDescription.slice(0, 110)}…</p>
      </a>
    ))}
  </div>
</BaseLayout>
