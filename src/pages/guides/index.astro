---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/content/Breadcrumbs.astro';
import { siteConfig } from '../../config/site';
import { guides } from '../../data/guides';
import { breadcrumbJsonLd, collectionPageJsonLd } from '../../lib/seo';

const path = '/guides/';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Guides', path }];
const guidesDescription =
  'Plain-English guides on writing estimates and quotes, invoices, contracts and forms, each linked to a free generator.';
const jsonLd = [
  breadcrumbJsonLd(crumbs),
  collectionPageJsonLd({
    name: 'Business Guides: Estimates, Invoices, Contracts',
    description: guidesDescription,
    path,
    items: guides.map((g) => ({ name: g.title, path: `/guides/${g.slug}/` })),
  }),
];

const groups: { heading: string; match: (slug: string) => boolean }[] = [
  {
    heading: 'Estimates, invoices & receipts',
    match: (s) =>
      /invoice|estimate|receipt|line-item|work-order|purchase-order|change-order|payment-terms|cleaning|catering|construction/.test(
        s,
      ),
  },
  {
    heading: 'Contracts & NDA',
    match: (s) => /contract|nda|freelance-payment|freelance-contract|wedding/.test(s),
  },
  {
    heading: 'Forms & creative',
    match: (s) => /tattoo|rental|podcast|real-estate|flyer/.test(s),
  },
];

const used = new Set<string>();
const grouped = groups.map((g) => {
  const items = guides.filter((guide) => g.match(guide.slug) && !used.has(guide.slug));
  items.forEach((i) => used.add(i.slug));
  return { heading: g.heading, items };
});
const leftover = guides.filter((g) => !used.has(g.slug));
if (leftover.length) {
  grouped.push({ heading: 'More guides', items: leftover });
}
---
<BaseLayout
  title="Business Guides: Estimates, Invoices, Contracts"
  description={guidesDescription}
  path={path}
  jsonLd={jsonLd}
  ogImagePath="/og/guides.png"
  ogImageAlt={`${siteConfig.siteName} business document guides`}
>
  <Breadcrumbs items={crumbs} />
  <h1>Guides</h1>
  <p class="lead answer-first">
    Plain-English how-tos for estimates and quotes, invoices and payment terms, contracts and NDAs, work orders, receipts, consent forms, rental applications, and creative templates—each linked to a matching free generator.
  </p>
  {grouped.map((g) =>
    g.items.length ? (
      <section>
        <h2>{g.heading}</h2>
        <div class="tool-grid">
          {g.items.map((guide) => (
            <a class="tool-card" href={`/guides/${guide.slug}/`}>
              <h3>{guide.title}</h3>
              <p>{guide.metaDescription.slice(0, 110)}…</p>
            </a>
          ))}
        </div>
      </section>
    ) : null,
  )}
</BaseLayout>
