---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { getFeaturedTools } from '../data/tools';

const featured = getFeaturedTools();
---
<BaseLayout
  title="Page not found"
  description={`Sorry, that page is missing. Browse free invoice, estimate, contract, and form generators on ${siteConfig.siteName}, or return home.`}
  path="/404/"
  noindex={true}
>
  <h1>Page not found</h1>
  <p>Try one of our document generators:</p>
  <ul>
    {featured.map((t) => (
      <li><a href={`/tools/${t.slug}/`}>{t.name}</a></li>
    ))}
  </ul>
  <p><a href="/tools/">All tools</a> · <a href="/">Home</a></p>
</BaseLayout>
