---
import BaseLayout from '../layouts/BaseLayout.astro';
import { allTools } from '../data/tools';
---
<BaseLayout
  title="Page not found"
  description="Sorry, that page is missing. Browse free invoice, estimate, contract, and form generators on DocuForge Tools, or return home."
  path="/404/"
  noindex={true}
>
  <h1>Page not found</h1>
  <p>Try one of our document generators:</p>
  <ul>
    {allTools.slice(0, 8).map((t) => (
      <li><a href={`/tools/${t.slug}/`}>{t.name}</a></li>
    ))}
  </ul>
  <p><a href="/tools/">All tools</a> · <a href="/">Home</a></p>
</BaseLayout>
