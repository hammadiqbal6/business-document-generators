---
import type { ToolDefinition } from '../../data/tools/types';
import './generator.css';

interface Props {
  tool: ToolDefinition;
  embed?: boolean;
  /** When true (default on tool pages), mount the editor immediately so fields are above the fold. */
  autoOpen?: boolean;
}

const { tool, embed = false, autoOpen = false } = Astro.props;
const toolJson = JSON.stringify(tool);

/** First simple field for a static answer-first shell (visible before React mounts). */
const shellField = tool.fields.find(
  (f) =>
    f.type === 'text' ||
    f.type === 'email' ||
    f.type === 'tel' ||
    f.type === 'number' ||
    f.type === 'date' ||
    f.type === 'currency' ||
    f.type === 'textarea' ||
    f.type === 'select',
);
const shellDefault = shellField ? tool.defaults[shellField.id] : '';
const shellValue =
  shellDefault == null || typeof shellDefault === 'object' ? '' : String(shellDefault);
---

<div
  class="generator-lazy"
  data-embed={embed ? '1' : '0'}
  data-auto-open={autoOpen ? '1' : '0'}
  data-tool={toolJson}
>
  {!autoOpen && (
    <div class="generator-lazy__prompt">
      <p>
        Open the editor to fill fields, see a live preview, and export PDF or DOCX. Heavy scripts load only
        after you click—nothing runs until then.
      </p>
      <button type="button" class="btn btn--primary" data-generator-load>Open editor</button>
    </div>
  )}
  {autoOpen && shellField && (
    <div class="generator generator--shell" data-generator-shell>
      <div class="generator__form">
        <fieldset class="generator__section">
          <legend>{shellField.section || 'Details'}</legend>
          <div class="field">
            <label for={`shell-${tool.slug}-${shellField.id}`}>
              {shellField.label}
              {shellField.required ? ' *' : ''}
            </label>
            {shellField.type === 'textarea' ? (
              <textarea
                id={`shell-${tool.slug}-${shellField.id}`}
                name={shellField.id}
                rows={shellField.rows || 3}
                required={shellField.required}
              >{shellValue}</textarea>
            ) : shellField.type === 'select' ? (
              <select
                id={`shell-${tool.slug}-${shellField.id}`}
                name={shellField.id}
                required={shellField.required}
              >
                {(shellField.options || []).map((o) => (
                  <option value={o.value} selected={o.value === shellValue}>
                    {o.label}
                  </option>
                ))}
              </select>
            ) : (
              <input
                id={`shell-${tool.slug}-${shellField.id}`}
                name={shellField.id}
                type={
                  shellField.type === 'currency' || shellField.type === 'number'
                    ? 'number'
                    : shellField.type === 'email'
                      ? 'email'
                      : shellField.type === 'tel'
                        ? 'tel'
                        : shellField.type === 'date'
                          ? 'date'
                          : 'text'
                }
                value={shellValue}
                required={shellField.required}
                inputmode={shellField.inputMode}
                placeholder={shellField.placeholder}
              />
            )}
          </div>
          <p class="generator-lazy__shell-hint">Loading the full editor with live preview…</p>
        </fieldset>
      </div>
      <button type="button" class="btn btn--primary" data-generator-load hidden>Open editor</button>
    </div>
  )}
  {autoOpen && !shellField && (
    <div class="generator-lazy__prompt generator-lazy__prompt--loading" data-generator-loading>
      <p>Loading editor…</p>
      <button type="button" class="btn btn--primary" data-generator-load hidden>Open editor</button>
    </div>
  )}
  <div class="generator-lazy__mount" hidden></div>
</div>

<style>
  .generator-lazy__prompt {
    margin: 0.75rem 0 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border, #d8dee4);
    border-radius: 8px;
    background: var(--color-surface, #f6f8fa);
  }
  .generator-lazy__prompt--loading {
    min-height: 4.5rem;
    display: flex;
    align-items: center;
  }
  .generator-lazy__prompt p {
    margin: 0 0 0.75rem;
    max-width: 52ch;
  }
  .generator-lazy__prompt--loading p {
    margin: 0;
  }
  .generator--shell {
    margin: 0.5rem 0 1rem;
  }
  .generator-lazy__shell-hint {
    margin: 0.75rem 0 0;
    font-size: 0.9rem;
    color: var(--muted, #4a5c56);
  }
  .generator-lazy__error {
    color: #a12020;
    margin: 0 0 0.75rem;
  }
</style>

<script>
  function wireLazyGenerator(root) {
    const btn = root.querySelector('[data-generator-load]');
    const prompt = root.querySelector('.generator-lazy__prompt');
    const shell = root.querySelector('[data-generator-shell]');
    const mountEl = root.querySelector('.generator-lazy__mount');
    const embed = root.dataset.embed === '1';
    const autoOpen = root.dataset.autoOpen === '1';
    if (!mountEl) return;

    let started = false;
    async function openEditor() {
      if (started) return;
      started = true;
      if (btn) {
        btn.disabled = true;
        btn.setAttribute('aria-busy', 'true');
        btn.textContent = 'Loading editor…';
        btn.hidden = false;
      }
      try {
        const tool = JSON.parse(root.dataset.tool || '{}');
        const { mountDocumentGenerator } = await import('../../lib/mountDocumentGenerator.tsx');
        prompt?.remove();
        shell?.remove();
        mountEl.hidden = false;
        mountDocumentGenerator(mountEl, tool, embed);
      } catch (err) {
        console.error(err);
        started = false;
        if (btn) {
          btn.disabled = false;
          btn.removeAttribute('aria-busy');
          btn.hidden = false;
          btn.textContent = 'Open editor';
        }
        const msg = document.createElement('p');
        msg.className = 'generator-lazy__error';
        msg.setAttribute('role', 'alert');
        msg.textContent = 'Could not load the editor. Please refresh and try again.';
        root.prepend(msg);
      }
    }

    if (autoOpen) {
      void openEditor();
    } else if (btn) {
      btn.addEventListener('click', () => void openEditor(), { once: true });
    }
  }

  document.querySelectorAll('.generator-lazy').forEach(wireLazyGenerator);
</script>
