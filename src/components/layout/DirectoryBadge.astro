---
/**
 * External directory / launch-board badge (e.g. Fazier, TinyLaunch).
 * Do not name a prop `slot` — Astro reserves that for component slots.
 * Image URL prop is `src` (JSON env field is `img`).
 */
interface Props {
  href: string;
  src: string;
  alt: string;
  width: number;
  height: number;
  /** Optional link rel; omit for a normal followable link. */
  rel?: string;
  /** Open in a new tab (Fazier's official embed uses target="_blank"). */
  newTab?: boolean;
}

const { href, src, alt, width, height, rel, newTab = true } = Astro.props;
---
<a
  class="directory-badge"
  href={href}
  {...(newTab ? { target: '_blank' } : {})}
  {...(rel ? { rel } : {})}
>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
  />
</a>
