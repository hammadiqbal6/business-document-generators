---
import type { ToolDefinition } from '../../data/tools/types';

interface Props {
  tools: ToolDefinition[];
  title?: string;
}

const { tools, title = 'Related tools' } = Astro.props;
---
{tools.length > 0 && (
  <section class="related-tools" aria-labelledby="related-tools-heading">
    <h2 id="related-tools-heading">{title}</h2>
    <ul>
      {tools.map((t) => (
        <li><a href={`/tools/${t.slug}/`}>{t.name}</a></li>
      ))}
    </ul>
  </section>
)}
