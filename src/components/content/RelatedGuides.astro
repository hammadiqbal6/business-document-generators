---
import type { Guide } from '../../data/guides';

interface Props {
  guides: Guide[];
  title?: string;
}

const { guides, title = 'Related guides' } = Astro.props;
---
{guides.length > 0 && (
  <section class="related-guides" aria-labelledby="related-guides-heading">
    <h2 id="related-guides-heading">{title}</h2>
    <ul>
      {guides.map((g) => (
        <li><a href={`/guides/${g.slug}/`}>{g.title}</a></li>
      ))}
    </ul>
  </section>
)}
