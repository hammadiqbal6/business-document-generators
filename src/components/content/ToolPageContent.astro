---
import type { ToolDefinition } from '../../data/tools/types';
import TrustBlock from './TrustBlock.astro';

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
const c = tool.content;

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

/** Link bare /tools/.../ and /guides/.../ paths in tool SEO copy. */
function linkInternalPaths(para: string): string {
  return escapeHtml(para)
    .replace(/\/tools\/[a-z0-9-]+\//g, (path) => `<a href="${path}">${path}</a>`)
    .replace(/\/guides\/[a-z0-9-]+\//g, (path) => `<a href="${path}">${path}</a>`);
}
---
<article class="prose tool-content">
  <h2>How to use this {tool.shortName.toLowerCase()} generator</h2>
  <ol>
    {c.howToUse.map((step) => <li>{step}</li>)}
  </ol>

  {c.whatToInclude.map((section) => (
    <>
      <h2>{section.heading}</h2>
      {section.body.split(/\n\n+/).map((para) => (
        <p set:html={linkInternalPaths(para)} />
      ))}
    </>
  ))}

  <h2>{c.workedExample.heading}</h2>
  {c.workedExample.body.split(/\n\n+/).map((para) => (
    <p set:html={linkInternalPaths(para)} />
  ))}

  {c.tips.length > 0 && (
    <>
      <h2>Tips</h2>
      <ul>
        {c.tips.map((t) => <li set:html={linkInternalPaths(t)} />)}
      </ul>
    </>
  )}

  <h2>Common mistakes</h2>
  <ul>
    {c.commonMistakes.map((m) => <li>{m}</li>)}
  </ul>

  <h2>FAQ</h2>
  <div class="faq">
    {c.faq.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <p set:html={linkInternalPaths(item.answer)} />
      </details>
    ))}
  </div>

  <TrustBlock tool={tool} />
</article>
