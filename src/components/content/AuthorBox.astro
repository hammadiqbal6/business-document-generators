---
import { siteConfig } from '../../config/site';

interface Props {
  updatedAt: string;
}

const { updatedAt } = Astro.props;
const author = siteConfig.author;
---
<aside class="author-box" aria-label="Author">
  <p>
    Built and maintained by
    <a href="/about/#maintainer" rel="author">{author.name}</a>
    · Last reviewed <time datetime={updatedAt}>{updatedAt}</time>
  </p>
  <p>
    {author.shortBio}
    Contract and consent pages are editable samples only—not legal advice.
  </p>
</aside>
