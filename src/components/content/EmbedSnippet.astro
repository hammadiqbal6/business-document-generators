---
import type { ToolDefinition } from '../../data/tools/types';
import { absoluteUrl } from '../../lib/seo';
import { siteConfig } from '../../config/site';

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
const pageUrl = absoluteUrl(`/tools/${tool.slug}/`);
const embedUrl = absoluteUrl(`/tools/${tool.slug}/embed/`);
const snippet = `<iframe src="${embedUrl}" title="${tool.name}" width="100%" height="720" loading="lazy" style="border:0;max-width:100%;"></iframe>
<p>Tool by <a href="${pageUrl}">${siteConfig.siteName}</a></p>`;
---

<section class="embed-share" aria-labelledby="embed-h">
  <h2 id="embed-h">Embed this tool</h2>
  <p>
    Copy the snippet below to add a lightweight iframe to your site. Please keep the attribution
    link so visitors can open the full tool page.
  </p>
  <label class="sr-only" for={`embed-snippet-${tool.slug}`}>Embed HTML snippet</label>
  <textarea
    id={`embed-snippet-${tool.slug}`}
    class="embed-share__code"
    readonly
    rows="4"
    spellcheck="false"
    data-embed-code
  >{snippet}</textarea>
  <div class="embed-share__actions">
    <button type="button" class="btn btn--primary" data-embed-copy>Copy embed code</button>
    <a class="btn" href={`/tools/${tool.slug}/embed/`} target="_blank" rel="noopener">
      Open embeddable version
    </a>
  </div>
  <p class="embed-share__status" data-embed-status aria-live="polite"></p>
</section>

<style>
  .embed-share {
    margin: 2rem 0;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .embed-share__code {
    width: 100%;
    min-height: 7rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: max(0.85rem, 16px);
    padding: 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    resize: vertical;
    background: #fff;
    color: var(--ink);
  }
  .embed-share__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .embed-share__actions .btn {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
  .embed-share__status {
    margin: 0.5rem 0 0;
    min-height: 1.25em;
    font-size: 0.92rem;
    color: var(--brand-dark);
  }
</style>

<script>
  document.querySelectorAll('.embed-share').forEach((section) => {
    const ta = section.querySelector('[data-embed-code]');
    const btn = section.querySelector('[data-embed-copy]');
    const status = section.querySelector('[data-embed-status]');
    btn?.addEventListener('click', async () => {
      if (!(ta instanceof HTMLTextAreaElement)) return;
      try {
        await navigator.clipboard.writeText(ta.value);
        if (status) status.textContent = 'Copied. Paste into your page HTML.';
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'embed_snippet_copied', { tool: location.pathname });
        }
      } catch {
        ta.focus();
        ta.select();
        if (status) status.textContent = 'Press Ctrl/Cmd+C to copy the selected snippet.';
      }
    });
  });
</script>
