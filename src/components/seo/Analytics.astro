---
import { siteConfig } from '../../config/site';

const gaId = siteConfig.ga4MeasurementId;
---
{gaId && (
  <script is:inline define:vars={{ gaId }}>
    (function () {
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = gtag;

      // Consent Mode v2: load the tag with storage denied, then update on Accept.
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
      gtag('js', new Date());
      gtag('set', 'anonymize_ip', true);

      var CONSENT_KEY = 'docuforge:cookie-ok';
      var loaded = false;

      function loadGaTag() {
        if (loaded || !gaId) return;
        loaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
        document.head.appendChild(s);
        gtag('config', gaId, {
          anonymize_ip: true,
          send_page_view: true,
        });
      }

      function grantAnalytics() {
        gtag('consent', 'update', {
          analytics_storage: 'granted',
        });
        loadGaTag();
      }

      function denyAnalytics() {
        gtag('consent', 'update', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
      }

      // Always load the tag (with default denied) so Consent Mode can operate.
      // Events queue in dataLayer; storage stays off until the user accepts.
      function scheduleTagLoad() {
        var run = function () {
          loadGaTag();
          try {
            var v = localStorage.getItem(CONSENT_KEY);
            if (v === '1') {
              gtag('consent', 'update', { analytics_storage: 'granted' });
            } else if (v === '0') {
              denyAnalytics();
            }
          } catch (e) {
            /* ignore */
          }
        };
        if ('requestIdleCallback' in window) {
          requestIdleCallback(run, { timeout: 4000 });
        } else {
          setTimeout(run, 1500);
        }
      }

      if (document.readyState === 'complete') scheduleTagLoad();
      else window.addEventListener('load', scheduleTagLoad, { once: true });

      window.__docuforgeGrantAnalytics = grantAnalytics;
      window.__docuforgeDenyAnalytics = denyAnalytics;

      // Outbound reference clicks (sources / references)
      document.addEventListener(
        'click',
        function (ev) {
          var t = ev.target;
          if (!(t instanceof Element)) return;
          var a = t.closest('a[href]');
          if (!a || typeof window.gtag !== 'function') return;
          var href = a.getAttribute('href') || '';
          if (!/^https?:\/\//i.test(href)) return;
          if (href.indexOf(location.hostname) !== -1) return;
          var inRefs = a.closest('.refs, .trust, .prose');
          if (!inRefs) return;
          window.gtag('event', 'outbound_reference_click', {
            link_url: href,
            link_text: (a.textContent || '').trim().slice(0, 100),
          });
        },
        true,
      );
    })();
  </script>
)}
