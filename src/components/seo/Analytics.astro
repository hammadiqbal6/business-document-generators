---
import { siteConfig } from '../../config/site';
import { CONSENT_MODE_REGIONS } from '../../lib/consentRegions';

const gaId = siteConfig.ga4MeasurementId;
const consentRegions = [...CONSENT_MODE_REGIONS];
---
{gaId && (
  <script is:inline define:vars={{ gaId, consentRegions }}>
    (function () {
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = gtag;

      // Consent Mode v2 — region-scoped defaults for EEA/UK/CH (Google CMP / Funding Choices
      // updates these via TCF). Longer wait_for_update so the certified message can settle.
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 2000,
        region: consentRegions,
      });
      // Everywhere else: same denied defaults until the site cookie banner Accept.
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
      gtag('js', new Date());
      gtag('set', 'anonymize_ip', true);

      var CONSENT_KEY = 'docuforge:cookie-ok';
      var loaded = false;
      var configured = false;

      function loadGaTag() {
        if (!gaId) return;
        if (!loaded) {
          loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
        }
        if (!configured) {
          configured = true;
          gtag('config', gaId, {
            anonymize_ip: true,
            send_page_view: true,
          });
        }
      }

      function sendPageView() {
        if (typeof window.gtag !== 'function') return;
        gtag('event', 'page_view', {
          page_location: location.href,
          page_path: location.pathname + location.search,
          page_title: document.title,
        });
      }

      function grantAnalytics() {
        gtag('consent', 'update', {
          analytics_storage: 'granted',
        });
        if (configured) {
          // Tag already configured under denied consent — fire the page view now.
          sendPageView();
        } else {
          loadGaTag();
        }
      }

      function denyAnalytics() {
        gtag('consent', 'update', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
      }

      /**
       * Load gating:
       * - EEA/UK/CH: load with denied defaults so Consent Mode + Google CMP (TCF) can operate.
       * - Elsewhere: load only after Accept (or a prior Accept in localStorage). Grant BEFORE
       *   the first config so the initial page_view is not dropped under denied storage.
       */
      function scheduleTagLoad() {
        var run = function () {
          try {
            var geo = window.__docuklinGeo;
            if (geo && geo.consentRegion) {
              loadGaTag();
              return;
            }
            var v = localStorage.getItem(CONSENT_KEY);
            if (v === '1') {
              gtag('consent', 'update', { analytics_storage: 'granted' });
              loadGaTag();
            } else if (v === '0') {
              denyAnalytics();
            }
            // No preference yet: wait for Accept / Reject. Do not load gtag.js.
          } catch (e) {
            /* ignore */
          }
        };
        if ('requestIdleCallback' in window) {
          requestIdleCallback(run, { timeout: 4000 });
        } else {
          setTimeout(run, 1500);
        }
      }

      if (document.readyState === 'complete') scheduleTagLoad();
      else window.addEventListener('load', scheduleTagLoad, { once: true });

      window.__docuforgeGrantAnalytics = grantAnalytics;
      window.__docuforgeDenyAnalytics = denyAnalytics;

      // Outbound reference clicks (sources / references)
      document.addEventListener(
        'click',
        function (ev) {
          var t = ev.target;
          if (!(t instanceof Element)) return;
          var a = t.closest('a[href]');
          if (!a || typeof window.gtag !== 'function') return;
          var href = a.getAttribute('href') || '';
          if (!/^https?:\/\//i.test(href)) return;
          if (href.indexOf(location.hostname) !== -1) return;
          var inRefs = a.closest('.refs, .trust, .prose');
          if (!inRefs) return;
          window.gtag('event', 'outbound_reference_click', {
            link_url: href,
            link_text: (a.textContent || '').trim().slice(0, 100),
          });
        },
        true,
      );
    })();
  </script>
)}
