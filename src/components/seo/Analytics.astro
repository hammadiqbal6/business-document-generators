---
import { siteConfig } from '../../config/site';
import { CONSENT_MODE_REGIONS } from '../../lib/consentRegions';

const gaId = siteConfig.ga4MeasurementId;
const consentRegions = [...CONSENT_MODE_REGIONS];
---
{gaId && (
  <script is:inline define:vars={{ gaId, consentRegions }}>
    (function () {
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = gtag;

      // Consent Mode v2 — EEA/UK/CH: denied analytics + ads until Google CMP / opt-in.
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 2000,
        region: consentRegions,
      });
      // Everywhere else: analytics granted by default (owner policy 2026-11-27).
      // Ads also granted outside CMP regions so AdSense can measure; Reject / DNS flips all to denied.
      gtag('consent', 'default', {
        ad_storage: 'granted',
        ad_user_data: 'granted',
        ad_personalization: 'granted',
        analytics_storage: 'granted',
        wait_for_update: 500,
      });
      gtag('js', new Date());
      gtag('set', 'anonymize_ip', true);

      var CONSENT_KEY = 'docuforge:cookie-ok';
      var loaded = false;
      var configured = false;

      function loadGaTag() {
        if (!gaId) return;
        if (!loaded) {
          loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
        }
        if (!configured) {
          configured = true;
          gtag('config', gaId, {
            anonymize_ip: true,
            send_page_view: true,
          });
        }
      }

      function sendPageView() {
        if (typeof window.gtag !== 'function') return;
        gtag('event', 'page_view', {
          page_location: location.href,
          page_path: location.pathname + location.search,
          page_title: document.title,
        });
      }

      function grantAnalytics() {
        gtag('consent', 'update', {
          analytics_storage: 'granted',
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
        });
        if (configured) {
          sendPageView();
        } else {
          loadGaTag();
        }
      }

      function denyAnalytics() {
        gtag('consent', 'update', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
      }

      /**
       * Consent Mode v2 load path:
       * - Apply stored Accept/Reject preference (if any), then load gtag.js promptly
       *   (no idle delay — short visits were lost when the tag waited for requestIdleCallback).
       * - EEA/UK/CH defaults stay denied until Google CMP or Accept.
       * - Elsewhere defaults grant analytics (and ad storage); Reject / DNS denies and remembers.
       */
      function bootTag() {
        try {
          var v = null;
          try {
            v = localStorage.getItem(CONSENT_KEY);
          } catch (e) {
            /* ignore */
          }
          if (v === '1') {
            gtag('consent', 'update', {
              analytics_storage: 'granted',
              ad_storage: 'granted',
              ad_user_data: 'granted',
              ad_personalization: 'granted',
            });
          } else if (v === '0') {
            denyAnalytics();
          }
          loadGaTag();
        } catch (e) {
          loadGaTag();
        }
      }

      bootTag();

      window.__docuforgeGrantAnalytics = grantAnalytics;
      window.__docuforgeDenyAnalytics = denyAnalytics;

      // Outbound reference clicks (sources / references)
      document.addEventListener(
        'click',
        function (ev) {
          var t = ev.target;
          if (!(t instanceof Element)) return;
          var a = t.closest('a[href]');
          if (!a || typeof window.gtag !== 'function') return;
          var href = a.getAttribute('href') || '';
          if (!/^https?:\/\//i.test(href)) return;
          if (href.indexOf(location.hostname) !== -1) return;
          var inRefs = a.closest('.refs, .trust, .prose');
          if (!inRefs) return;
          window.gtag('event', 'outbound_reference_click', {
            link_url: href,
            link_text: (a.textContent || '').trim().slice(0, 100),
          });
        },
        true,
      );
    })();
  </script>
)}
