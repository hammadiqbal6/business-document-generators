# =============================================================================
# Docuklin configuration
# Full table: docs/CONFIGURATION.md
#
# BUILD-TIME (PUBLIC_* / INDEXNOW_*): baked into Astro HTML at `npm run build`.
# Set in Cloudflare Workers Builds → Variables, then rebuild. Do NOT put PUBLIC_*
# in wrangler.jsonc top-level `vars` (breaks `npx wrangler preview`).
#
# RUNTIME (Worker): CANONICAL_ORIGIN + LEGACY_REDIRECT_HOSTS live in wrangler.jsonc
# `vars` / dashboard Variables and apply on the next Worker deploy (no Astro rebuild).
# =============================================================================

# --- Identity & origin (build-time) -------------------------------------------

# Canonical site origin (no trailing slash). Canonicals, sitemap, OG, robots, llms, JSON-LD, IndexNow.
# Default: https://docuklin.com
PUBLIC_SITE_URL=https://docuklin.com

# Brand in header, titles, Organization / WebSite schema name.
# Default: Docuklin
PUBLIC_SITE_NAME=Docuklin

# Short brand for apple-mobile-web-app-title, webmanifest short_name, JSON-LD alternateName.
# Default: Docuklin
PUBLIC_SITE_SHORT_NAME=Docuklin

# Homepage / Organization description (longer).
# Default: Free niche business document generators — fill a form, preview live, export PDF or DOCX. Nothing leaves your browser.
PUBLIC_SITE_TAGLINE=Free niche business document generators — fill a form, preview live, export PDF or DOCX. Nothing leaves your browser.

# Shorter PWA / site.webmanifest description.
# Default: Free niche business document generators with PDF export
PUBLIC_MANIFEST_DESCRIPTION=Free niche business document generators with PDF export

# Contact email (Contact page, footer, Organization schema).
# Default: hammadiqbal117@gmail.com
PUBLIC_CONTACT_EMAIL=hammadiqbal117@gmail.com

# Footer © owner. Empty → uses PUBLIC_SITE_NAME.
# Default: (empty → Docuklin)
PUBLIC_COPYRIGHT_OWNER=

# Maintainer display name (About, bylines, Person schema).
# Default: Hammad Iqbal
PUBLIC_AUTHOR_NAME=Hammad Iqbal

# Maintainer email (Person schema). Default: same as contact email.
PUBLIC_AUTHOR_EMAIL=hammadiqbal117@gmail.com

# Person schema / About short bio.
PUBLIC_AUTHOR_BIO=I build and maintain free in-browser tools. I turn published public sources into practical generators and show which sources each page uses. I am not a lawyer, accountant, or licensed professional advisor.

# Primary profile URL (Person @id). Default: https://github.com/hammadiqbal6
PUBLIC_AUTHOR_URL=https://github.com/hammadiqbal6

# Comma-separated Person.sameAs URLs. Default: PUBLIC_AUTHOR_URL
PUBLIC_AUTHOR_SAME_AS=https://github.com/hammadiqbal6

# Comma-separated Organization.sameAs URLs. Empty → reuse author sameAs.
PUBLIC_ORG_SAME_AS=

# Theme color (meta theme-color, webmanifest theme_color, CSS --brand).
# Default: #0f6b5c
PUBLIC_THEME_COLOR=#0f6b5c

# Webmanifest background_color. Default: #ffffff
PUBLIC_BACKGROUND_COLOR=#ffffff

# og:locale. Default: en_US
PUBLIC_LOCALE=en_US

# <html lang>. Default: en
PUBLIC_HTML_LANG=en

# Sitewide published baseline (ISO date). Default: 2026-10-19
PUBLIC_LAUNCHED_AT=2026-10-19

# Organization logo path (JSON-LD). Default: /logo-512.png
PUBLIC_LOGO_PATH=/logo-512.png

# Default Open Graph image path. Default: /og-default.png
PUBLIC_OG_IMAGE_PATH=/og-default.png

# Default og:image:alt. `{name}` → site name. Default includes Docuklin wording.
PUBLIC_OG_IMAGE_ALT={name} — free invoice, estimate, and contract templates with PDF export

# Footer line on generated per-page OG SVGs. `{name}` → site name.
PUBLIC_OG_IMAGE_FOOTER={name} · Free PDF / DOCX templates

# Subtitle on og-default.svg.
PUBLIC_OG_DEFAULT_SUBTITLE=Free niche business document generators

# Twitter/X handle without @. Empty skips twitter:site.
PUBLIC_TWITTER_HANDLE=

# --- Sister sites (build-time) -----------------------------------------------

# Origins (no trailing slash).
PUBLIC_SITE_URL_PAYMENT_FEES=https://payment-fee-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_BUSINESS_DOCS=https://docuklin.com
PUBLIC_SITE_URL_HOME_GARDEN=https://home-garden-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_FIBER_ARTS=https://fiber-arts-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_PET=https://pet-calculators.hammadiqbal117.workers.dev

# Display names on /about/.
PUBLIC_SISTER_NAME_PAYMENT_FEES=FeeCalc (payment fee calculators)
PUBLIC_SISTER_NAME_HOME_GARDEN=YardCalc (home & garden calculators)
PUBLIC_SISTER_NAME_FIBER_ARTS=FiberCalc (knitting & crochet calculators)
PUBLIC_SISTER_NAME_PET=PetCalc (pet calculators)

# --- Integrations (build-time) -----------------------------------------------

# EmailJS contact form (public IDs only). All three required to show the form.
# docs/CONTACT-EMAILJS.md
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

# Google Analytics 4. Empty disables gtag. Default: G-HR4DDMD97H
PUBLIC_GA4_MEASUREMENT_ID=G-HR4DDMD97H

# Google Search Console HTML-tag verification.
PUBLIC_GSC_VERIFICATION=0-q_NxhBgfgCm4WOLfbe9VrHrjbLzaxh8SXsbo2Q-UU
# Legacy alias if PUBLIC_GSC_VERIFICATION is empty.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools meta verification. Empty until set up.
PUBLIC_BING_SITE_VERIFICATION=

# IndexNow key (must match public/{key}.txt).
PUBLIC_INDEXNOW_KEY=4d6f1ea5473a0968a83c67ceda5a0387
INDEXNOW_KEY=4d6f1ea5473a0968a83c67ceda5a0387
# Set to 1 to skip the IndexNow post-deploy ping.
INDEXNOW_DISABLE=

# AdSense (keep disabled until approved).
PUBLIC_ADSENSE_PUBLISHER_ID=
PUBLIC_ADS_ENABLED=false
PUBLIC_ADSENSE_AUTO_ADS=false

# --- Worker runtime (wrangler.jsonc `vars` / dashboard — not PUBLIC_*) -------
# Documented here for operators; do not copy these into Workers Builds PUBLIC_*.
#
# CANONICAL_ORIGIN=https://docuklin.com
#   Target origin for legacy-host 301s (no trailing slash). Runtime.
#
# LEGACY_REDIRECT_HOSTS=business-document-generators.hammadiqbal117.workers.dev
#   Comma-separated exact Host values that 301 → CANONICAL_ORIGIN. Runtime.
#   Do not include versioned preview hosts.
