# Build-time env vars read by Astro (`astro.config.mjs` + `src/config/site.ts`).
# Copy to `.env` for local builds. Cloudflare Workers Builds should set the same
# keys in the dashboard. Empty values mean "use code defaults / feature off".
# Never put real secrets here — these PUBLIC_* values are embedded in the static build.

# Canonical site origin (no trailing slash). Required for production canonicals, sitemap, OG, robots.txt, llms.txt.
# Example: https://business-document-generators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL=

# Brand name in titles, header, and Organization schema. Optional (default: DocuForge Tools).
# Example: DocuForge Tools
PUBLIC_SITE_NAME=

# Short homepage / Organization description. Optional.
# Example: Free niche business document generators in your browser.
PUBLIC_SITE_TAGLINE=

# Contact email on Contact page, footer, and schema. Optional but recommended at launch.
# Example: hello@example.com
PUBLIC_CONTACT_EMAIL=

# Twitter/X handle without @. Optional; omit to skip twitter:site meta.
# Example: yourbrand
PUBLIC_TWITTER_HANDLE=

# Google Analytics 4 measurement ID. Optional — empty/unset emits no GA/gtag code.
# Example: G-XXXXXXXXXX
PUBLIC_GA4_MEASUREMENT_ID=

# Google Search Console HTML-tag verification content value. Optional.
# Example: googleXXXXXXXXXXXXXXXX
PUBLIC_GSC_VERIFICATION=
# Legacy alias for PUBLIC_GSC_VERIFICATION (still read if the primary key is empty).
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools meta verification content. Optional.
# Example: XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PUBLIC_BING_SITE_VERIFICATION=

# IndexNow key string (must match public/{key}.txt). Optional.
# Example: a1b2c3d4e5f6
PUBLIC_INDEXNOW_KEY=

# Google AdSense publisher ID. Optional until AdSense approval.
# Example: ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_PUBLISHER_ID=

# Gate AdSense ad slots. Optional; must be the string "true" to enable (default false).
# Example: false
PUBLIC_ADS_ENABLED=

# Enable AdSense Auto ads when ads are on. Optional; "true" or "false" (default false).
# Example: false
PUBLIC_ADSENSE_AUTO_ADS=
