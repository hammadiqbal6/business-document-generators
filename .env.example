# Build-time env vars read by Astro (`astro.config.mjs` + `src/config/site.ts`)
# and post-deploy IndexNow (`scripts/indexnow.mjs`).
# Copy to `.env` for local builds. Cloudflare Workers Builds should set the same
# keys (see PR / docs/DEPLOYMENT.md). Never put private secrets here — PUBLIC_*
# values are embedded in the static build; IndexNow key is a public verification token.

# Canonical site origin (no trailing slash). Used for canonicals, sitemap, OG, robots, llms, JSON-LD, IndexNow.
# Fallback when unset: src/config/siteDefaults.mjs. Custom domain cutover: docs/CUSTOM-DOMAIN.md
PUBLIC_SITE_URL=https://business-document-generators.hammadiqbal117.workers.dev

# Sister-site origins (no trailing slash). Same names on all five repos.
# Used for sparse cross-links on About + topical tool pages. Switch these when custom domains arrive.
PUBLIC_SITE_URL_PAYMENT_FEES=https://payment-fee-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_BUSINESS_DOCS=https://business-document-generators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_HOME_GARDEN=https://home-garden-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_FIBER_ARTS=https://fiber-arts-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_PET=https://pet-calculators.hammadiqbal117.workers.dev

# Brand name in titles, header, and Organization schema.
PUBLIC_SITE_NAME=DocuForge Tools

# Short homepage / Organization description.
PUBLIC_SITE_TAGLINE=Free niche business document generators — fill a form, preview live, export PDF or DOCX. Nothing leaves your browser.

# Contact email on Contact page, footer, privacy/terms, About, and Organization schema.
PUBLIC_CONTACT_EMAIL=hammadiqbal117@gmail.com

# Twitter/X handle without @. Empty skips twitter:site meta (no account yet).
PUBLIC_TWITTER_HANDLE=

# Google Analytics 4 measurement ID. Empty disables gtag.
PUBLIC_GA4_MEASUREMENT_ID=G-HR4DDMD97H

# Google Search Console HTML-tag verification (meta name="google-site-verification").
PUBLIC_GSC_VERIFICATION=0-q_NxhBgfgCm4WOLfbe9VrHrjbLzaxh8SXsbo2Q-UU

# Legacy alias for PUBLIC_GSC_VERIFICATION (still read if the primary key is empty). Prefer PUBLIC_GSC_VERIFICATION.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools meta verification content. Empty until Bing is set up.
PUBLIC_BING_SITE_VERIFICATION=

# IndexNow key for robots.txt / site config (must match public/{key}.txt).
PUBLIC_INDEXNOW_KEY=4d6f1ea5473a0968a83c67ceda5a0387

# IndexNow key for post-deploy ping script (scripts/indexnow.mjs). Same public token as above.
INDEXNOW_KEY=4d6f1ea5473a0968a83c67ceda5a0387

# Set to 1 to skip the IndexNow post-deploy ping entirely.
INDEXNOW_DISABLE=

# Google AdSense publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX). Leave empty until AdSense approval.
PUBLIC_ADSENSE_PUBLISHER_ID=

# Gate AdSense ad slots. Must be the string "true" to enable (default false). Keep false until approved.
PUBLIC_ADS_ENABLED=false

# Enable AdSense Auto ads when ads are on. Keep false until approved.
PUBLIC_ADSENSE_AUTO_ADS=false
