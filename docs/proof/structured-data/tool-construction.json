  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is a construction estimate legally binding?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Often an estimate is an invitation to agree on price, not a contract—unless your wording or local law treats it as an offer you both accept. Pair accepted estimates with a signed contract or work order."
        }
      },
      {
        "@type": "Question",
        "name": "How long should an estimate stay valid?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Many contractors use 14–30 days. Material-heavy jobs may need shorter windows when lumber or appliance prices move quickly."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between an estimate and a bid?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "An estimate is typically a professional opinion of cost; a bid is often a firm offer in a competitive process. Confirm how your client uses the terms."
        }
      },
      {
        "@type": "Question",
        "name": "Do I need to include tax on every line?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Follow your jurisdiction’s rules. Many estimates show a single tax rate on taxable subtotal; some materials are tax-exempt for resale—label those clearly."
        }
      }
    ]
  }
